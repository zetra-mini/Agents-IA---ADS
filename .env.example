# ==============================================================================
# SELETOR DE PROVEDOR DE IA (Prioridade Local/OpenCode -> Opções Externas)
# Valores aceitos para LLM_PROVIDER:
#   opencode  -> Servidor compatível OpenCode (ex: opencode serve) [Prioritário]
#   ollama    -> IA 100% Localhost (Ollama em http://host.docker.internal:11434)
#   anthropic -> Anthropic Claude (externo)
#   openai    -> OpenAI GPT-4o / GPT-4.1 (externo)
#   google    -> Google Gemini (externo)
# ==============================================================================
LLM_PROVIDER=ollama

# --- 1. OpenCode (endpoint OpenAI-compatible local/gateway) ---
OPENCODE_MODEL=opencode/mimo-v2.6-flash-free
OPENCODE_BASE_URL=http://host.docker.internal:4096/v1
OPENCODE_API_KEY=opencode

# --- 2. Ollama (IA Local - 100% Localhost) ---
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 3. Opções Externas (Preencha apenas o provedor que for utilizar) ---
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# PASTA DE CRIATIVOS & AUTOMAÇÃO BROWSER-USE / META ADS
# ==============================================================================
# No Docker, HOST_CREATIVES_DIR é montado em /app/criativos (padrão ./criativos).
# Localmente (sem Docker), informe qualquer caminho absoluto ou ./criativos.
HOST_CREATIVES_DIR=./criativos
CREATIVES_DIR=/app/criativos
META_ADS_URL=https://adsmanager.facebook.com/adsmanager/manage/campaigns
BROWSER_HEADLESS=true
BROWSER_USER_DATA_DIR=/app/browser_profile
BROWSER_MAX_STEPS=40

# ==============================================================================
# API FASTAPI & DASHBOARDS (Astro / Svelte)
# ==============================================================================
APP_HOST=0.0.0.0
APP_PORT=8010
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://127.0.0.1:4321,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:4173
